diff --git a/src/protos.h b/src/protos.h
index 2288ee6d..1ca4ca35 100644
--- a/src/protos.h
+++ b/src/protos.h
@@ -42,6 +42,28 @@
 #include "dynbuf.h"
 #include <ctype.h>
 
+#ifdef __CCGO__
+/* The Go build (modernc.org/ccgo) cannot fork or popen.  These hooks are
+   implemented in Go; see the remindgo repository. */
+FILE *rem_popen(char const *cmd, char const *mode);
+int rem_pclose(FILE *fp);
+void rem_system_devnull(char const *cmd, int stdout_to_stderr);
+void rem_limit_execution_time(int seconds);
+void rem_unlimit_execution_time(void);
+void rem_exit(int status);
+int rem_atexit(void (*func)(void));
+typedef void (*rem_sighandler_t)(int);
+rem_sighandler_t rem_signal(int sig, rem_sighandler_t handler);
+void rem_flush_file_cache(void);
+#define popen(cmd, mode) rem_popen((cmd), (mode))
+#define pclose(fp) rem_pclose(fp)
+/* When remind runs inside another Go program, exit() must unwind to the
+   caller instead of ending the process, the caller runs the handlers
+   registered with atexit(), and rem_signal() installs no handlers. */
+#define exit(status) rem_exit(status)
+#define atexit(func) rem_atexit(func)
+#endif
+
 int CallUserFunc (char const *name, int nargs, ParsePtr p);
 int DoFset (ParsePtr p);
