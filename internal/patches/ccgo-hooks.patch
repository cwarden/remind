+#ifdef __CCGO__
+/* Discard every cached file.  The Go build calls this between in-process
+   runs so that files edited since the previous run are read again. */
+void rem_flush_file_cache(void)
+{
+    while (CachedFiles) {
+        DestroyCache(CachedFiles);
+    }
+}
+#endif
